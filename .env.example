# Razorpay — get from razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY="rzp_live_XXXXXXXXXXXXXXXX"    # key_id — used by frontend
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"   # key_secret — server-side only

# Shiprocket — your shiprocket.in login credentials
SHIPROCKET_EMAIL="you@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Gmail SMTP — for sending order confirmation and enquiry emails
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Generate a password for "Mail" and paste it below
GMAIL_USER="enriclance09@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
